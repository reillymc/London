<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    {{> "head"}}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
        crossorigin=""
        referrerpolicy="no-referrer"/>
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.4.1/dist/MarkerCluster.css"
        integrity="sha384-lPzjPsFQL6te2x+VxmV6q1DpRxpRk0tmnl2cpwAO5y04ESyc752tnEWPKDfl1olr"
        crossorigin=""
        referrerpolicy="no-referrer"/>
    <link rel="stylesheet" href="{{asset "built/journey-map.css"}}">
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin=""
        referrerpolicy="no-referrer" defer></script>
    <script src="https://unpkg.com/leaflet.markercluster@1.4.1/dist/leaflet.markercluster.js"
        integrity="sha384-RLIyj5q1b5XJTn0tqUhucRZe40nFTocRP91R/NkRJHwAe4XxnTV77FXy/vGLiec2"
        crossorigin=""
        referrerpolicy="no-referrer" defer></script>
    <script src="{{asset "built/journey-map.js"}}" defer></script>
</head>
<body class="{{> "body-class"}} journey-map-page">
<div class="site-wrapper">
    {{> "header"}}

    <main id="site-main" class="site-main journey-main">
        {{#get "posts" include="tags" limit="100" order="published_at desc" as |posts|}}
            <div id="journey-post-list" hidden>
                {{#foreach posts}}
                    <div class="journey-post"
                        data-title="{{title}}"
                        data-date="{{published_at}}"
                        data-url="{{url}}"
                        data-image="{{#if feature_image}}{{img_url feature_image size="m"}}{{/if}}"
                        data-image-alt="{{feature_image_alt}}"
                        data-excerpt="{{excerpt}}"
                        data-target-ids="{{#foreach tags}}{{slug}}{{#unless @last}} {{/unless}}{{/foreach}}"></div>
                {{/foreach}}
            </div>
        {{/get}}

        {{#post}}
        <div class="journey-layout">
            <div class="journey-panel-column">
                <article class="journey-panel">
                    <header class="journey-panel-header">
                        <h1 class="journey-panel-title">{{title}}</h1>
                    </header>

                    <div class="journey-panel-content gh-content">
                        {{content}}
                    </div>

                    {{#get "tags" filter="slug:~^'trip-'" limit="100" order="name asc" include="count.posts" as |tags|}}
                        <nav class="journey-index" aria-label="Trips">
                            <ul class="journey-index-list">
                                {{#foreach tags}}
                                    <li class="journey-index-entry">
                                        <button type="button" class="journey-index-item"
                                            data-target-id="{{slug}}"
                                            data-color="{{accent_color}}"
                                            data-description="{{description}}">
                                            <span class="journey-index-swatch"{{#if accent_color}} style="--index-color: {{accent_color}}"{{/if}}></span>
                                            <span class="journey-index-label">{{name}}</span>
                                        </button>
                                        {{#match count.posts "=" 1}}
                                            {{#get "posts" filter="tag:{{slug}}" limit="1" as |tagPosts|}}
                                                {{#foreach tagPosts}}
                                                    <a class="journey-index-link" href="{{url}}" aria-label="View {{title}}"></a>
                                                {{/foreach}}
                                            {{/get}}
                                        {{else}}
                                            <a class="journey-index-link" href="{{url}}" aria-label="View {{name}} tag page"></a>
                                        {{/match}}
                                    </li>
                                {{/foreach}}
                            </ul>
                        </nav>
                    {{/get}}
                </article>

                {{> "footer"}}
            </div>

            <div class="journey-map-column">
                {{> "journey-map"}}
            </div>
        </div>
        {{/post}}
    </main>
</div>

{{> "pswp"}}

<script src="{{asset "built/main.min.js"}}"></script>

{{ghost_foot}}

</body>
</html>
